# Apache / cPanel hosting.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve /sarees/<id> straight from sarees/<id>/index.html (written at build time for link
  # previews) without Apache's automatic redirect to a trailing-slash URL.
  DirectorySlash Off
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # Everything else that is not a real file goes to the React app, so page refreshes work.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /index.html [L]
</IfModule>
